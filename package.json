{
  "name": "iri-style-guide",
  "version": "1.0.0",
  "description": "IRI Style Guide with Data Dictionary Generator",
  "type": "module",
  "//": "Modified by Cursor: added local debugging scripts (2026-02-09)",
  "scripts": {
    "build:dictionary": "tsx scripts/generate-dictionary.ts",
    "validate:specs": "tsx scripts/validate-specs.ts",
    "debug:dictionary": "node --inspect-brk --enable-source-maps --import tsx scripts/generate-dictionary.ts",
    "debug": "npm run debug:dictionary",
    "build": "npm run build:dictionary",
    "harness": "node harness/run.mjs",
    "harness:demo": "node harness/run.mjs --spec docs/specs/fundtransfer_1.0.1.yaml --schema FundTransferRequest --cases harness/cases/fundtransfer",
    "harness:roots": "node harness/run.mjs --spec docs/specs/fundtransfer_1.0.1.yaml --schema FundTransferRequest --cases harness/cases/fundtransfer --apply FundTransferRequest,Party,TransactionAmounts,FundTransferFunds,FundTransferItem,FundSegment,Producer",
    "harness:classify": "node harness/run.mjs --spec docs/specs/fundtransfer_1.0.1.yaml --suggest",
    "harness:suggested": "node harness/run.mjs --spec docs/specs/fundtransfer_1.0.1.yaml --schema FundTransferRequest --cases harness/cases/fundtransfer --apply suggested"
  },
  "keywords": [
    "openapi",
    "data-dictionary",
    "api-documentation"
  ],
  "license": "MIT",
  "devDependencies": {
    "@apidevtools/swagger-parser": "^10.1.0",
    "@types/node": "^20.10.0",
    "ajv": "^8.17.1",
    "js-yaml": "^4.1.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "xlsx": "^0.18.5"
  }
}
