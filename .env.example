# Optional: where modular specs resolve shared OpenAPI fragments from.
# Used when bundling or validating docs/specs/src/*.yaml (see docs/CONTRIBUTING.md).
#
# Modified by Cursor

# Default when unset: ../shared (local files under docs/specs/shared in this repo)

# Working-group repo — consume published shared components over HTTPS:
# SHARED_SPECS_BASE=https://specs.dfa.irionline.org/specs/shared

# Pin to a specific release branch or tag (raw GitHub):
# SHARED_SPECS_BASE=https://raw.githubusercontent.com/Insured-Retirement-Institute/Digital-First-Specifications/main/docs/specs/shared
